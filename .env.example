# Copy this file to .env and fill in your own values. Never commit .env.

# Claude API key from console.anthropic.com. Leave empty to run in OFFLINE mode
# (deterministic parsers only; no web search for emails, template outreach emails).
ANTHROPIC_API_KEY=

# Model used for request parsing, contact research and email drafting.
CLAUDE_MODEL=claude-opus-5-5

# Hard cap on Claude web searches per run (cost control). When it is reached,
# remaining doctors are parked as PENDING_ENRICHMENT and picked up on the next run.
MAX_WEB_SEARCHES_PER_RUN=60

# Outreach sending: "simulate" writes .eml files to outbox/ (default).
# "smtp" sends through the SMTP account below (use a TEST inbox only).
SEND_MODE=simulate
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_NAME=Medic Paths Partnerships
SENDER_EMAIL=partnerships@example.com
# In smtp mode every email is redirected here instead of the doctor, so a demo never reaches a real doctor.
TEST_RECIPIENT_OVERRIDE=
